diff -ruN '--exclude=.*' orig/haikuwebkit/Source/WebKitLegacy/haiku/WebCoreSupport/FrameLoaderClientHaiku.cpp haikuwebkit/Source/WebKitLegacy/haiku/WebCoreSupport/FrameLoaderClientHaiku.cpp
--- orig/haikuwebkit/Source/WebKitLegacy/haiku/WebCoreSupport/FrameLoaderClientHaiku.cpp	2026-08-06 17:34:32.007864200 +0000
+++ haikuwebkit/Source/WebKitLegacy/haiku/WebCoreSupport/FrameLoaderClientHaiku.cpp	2026-09-07 00:06:57.000000000 +0000
@@ -150,6 +150,26 @@
 
 void FrameLoaderClientHaiku::detachedFromParent2()
 {
+    // Nobody owns the BWebFrame that BWebFrame::AddChild() makes for a
+    // subframe. It holds a RefPtr to the frame, the frame owns its
+    // FrameLoader, the FrameLoader owns this client, and this client is the
+    // only thing that points back at the BWebFrame -- a cycle with no outside
+    // reference to break it. So every subframe of every page ever loaded
+    // stayed alive for the life of the process, and with it its Document, its
+    // DOM tree, its decoded images and its JavaScript wrappers.
+    //
+    // This is where WebKit tells a client that a frame is being taken apart,
+    // so this is where the cycle has to be broken. The page's main frame is
+    // owned by BWebPage and reused across navigations, so it is left alone.
+    // FrameLoader::detachFromParent() holds a Ref to the frame across this
+    // call, so releasing the last reference here cannot destroy the object the
+    // caller is standing on.
+    if (m_webFrame != nullptr && m_webPage != nullptr
+        && m_webFrame != m_webPage->MainFrame()) {
+        BWebFrame* frame = m_webFrame;
+        m_webFrame = nullptr;
+        delete frame;
+    }
 }
 
 void FrameLoaderClientHaiku::detachedFromParent3()
