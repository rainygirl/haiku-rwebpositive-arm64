+    // The second one is what mattered. WTF_OVERRIDE_DELETE_FOR_CHECKED_PTR on
+    // PathImpl defines a destroying operator delete whose body is
+    // "object->PathImpl::~PathImpl()": a qualified, non-virtual call. So
+    // deleting a PathHaiku through a PathImpl* ran the base destructor, freed
+    // the memory, and never ran ~PathHaiku -- which meant the BShape member
+    // was never destroyed and the point and operation arrays it had malloc'd
+    // (a kilobyte or three per path) stayed behind. WebKit builds a Path for
+    // every rounded-rect clip, so a page with border-radius on anything that
+    // repaints leaked a few thousand of those a second.
+    WTF_MAKE_TZONE_ALLOCATED(PathHaiku);
+    WTF_OVERRIDE_DELETE_FOR_CHECKED_PTR(PathHaiku);
 public:
     static Ref<PathHaiku> create(std::span<const PathSegment> = { });
     static Ref<PathHaiku> create(const PathSegment&);
