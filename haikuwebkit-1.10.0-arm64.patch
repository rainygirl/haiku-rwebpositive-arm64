@@ -50,12 +52,57 @@
 
 RefPtr<Font> FontCache::systemFallbackForCharacterCluster(const FontDescription& description,
 	const Font& /*originalFontData*/, WebCore::IsForPlatformFont,
-	WebCore::FontCache::PreferColoredFont, StringView)
+	WebCore::FontCache::PreferColoredFont, StringView stringView)
 {
+    // This is the hook WebKit calls when the font chosen for a run has no
+    // glyph for some character. Returning "Sans" unconditionally -- which is
+    // what this did before -- means every character outside that one family's
+    // coverage is drawn as a .notdef box, however many suitable fonts are
+    // installed: all of CJK, for one. Ask app_server which installed family
+    // can draw the cluster instead.
+    if (!stringView.isEmpty()) {
+        CString utf8 = stringView.utf8();
+        int32 characterCount = 0;
+        for (unsigned i = 0; i < stringView.length(); ++i) {
+            if (!U16_IS_TRAIL(stringView[i]))
+                characterCount++;
+        }
+        if (characterCount > 0) {
+            auto hasGlyphs = makeUniqueArray<bool>(characterCount);
+            int32 familyCount = count_font_families();
+            for (int32 i = 0; i < familyCount; i++) {
+                font_family family;
+                uint32 flags;
+                if (get_font_family(i, &family, &flags) != B_OK)
+                    continue;
+
+                BFont font;
+                if (font.SetFamilyAndStyle(family, NULL) != B_OK)
+                    continue;
+
+                for (int32 c = 0; c < characterCount; c++)
+                    hasGlyphs[c] = false;
+                font.GetHasGlyphs(utf8.data(), characterCount, hasGlyphs.get());
+
+                bool complete = true;
+                for (int32 c = 0; c < characterCount; c++) {
+                    if (!hasGlyphs[c]) {
+                        complete = false;
+                        break;
+                    }
+                }
+                if (!complete)
+                    continue;
+
+                FontPlatformData data(description, AtomString::fromUTF8(family));
+                if (RefPtr<Font> result = fontForPlatformData(data))
+                    return result;
+            }
+        }
+    }
+
+    // Nothing installed covers it; the caller still needs a font.
     FontPlatformData data(description, AtomString::fromUTF8("Sans"));
-        // FIXME check that the requested characters are actually available,
-        // and try to use the other info in the arguments (should this be
-        // monospace, etc)
     return fontForPlatformData(data);
 }
 
